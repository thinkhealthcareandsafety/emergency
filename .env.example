# Copy to .env (for Docker) or server/.env (for `npm run dev`) and fill in.

# ---- Core
NODE_ENV=production
PORT=4000
# Leave empty for an in-memory demo database. Use a real MongoDB (Atlas or the compose service) for production.
MONGO_URI=mongodb://localhost:27017/ert
TZ=Asia/Kolkata
# How CSV dates like 01/10/2026 are read: DMY (India) or MDY
DATE_ORDER=DMY

# ---- Secrets (the server refuses to start in production with the defaults)
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Read-only key in the smart-screen URL: /display/MAIN?key=...
DISPLAY_KEY=change-me-display-key
# Key HONO / middleware / biometric bridge sends in the x-api-key header
INGEST_API_KEY=change-me-ingest-key
CORS_ORIGIN=*

# ---- Public address
# Your domain for automatic HTTPS (docker compose --profile https)
DOMAIN=ert.example.com
# The address people and HONO reach the app on (used in QR codes and webhook hints)
PUBLIC_URL=https://ert.example.com

# ---- Live demo QR punching (phones punch in from a QR on the screen). Turn OFF in production.
DEMO_PUNCH=false
DEMO_PUNCH_KEY=change-me-demo-key

# ---- Behaviour
# Property created on first start (rename it any time in Admin → Properties)
DEFAULT_PROPERTY=MAIN
DEFAULT_PROPERTY_NAME=Main Property
# Punched in longer than this without a punch-out => "Unconfirmed" (editable in admin)
STALE_AFTER_HOURS=14
# Create a placeholder employee when a punch arrives for an unknown code (so headcount stays right)
AUTO_CREATE_UNKNOWN=true

# ---- HONO HR pull sync (values come from HONO for your tenant)
HONO_ENABLED=false
HONO_BASE_URL=https://your-tenant.honohr.com
HONO_PUNCH_PATH=/api/attendance/punches
HONO_METHOD=GET
HONO_AUTH_HEADER=Authorization
HONO_AUTH_PREFIX=Bearer
HONO_API_KEY=
# Optional JSON of extra headers, e.g. {"x-tenant-id":"abc"}
HONO_EXTRA_HEADERS=
HONO_FROM_PARAM=from
HONO_TO_PARAM=to
# iso | epoch | epochms | local
HONO_DATE_FORMAT=iso
# Where the array of punches lives in the JSON response, e.g. "data" or "result.punches"
HONO_RECORDS_PATH=data
HONO_FIELD_EMP=employeeCode
HONO_FIELD_TIME=punchTime
HONO_FIELD_TYPE=punchType
HONO_FIELD_PROPERTY=location
# If HONO uses codes for direction, list them, e.g. HONO_IN_VALUES=0  HONO_OUT_VALUES=1
HONO_IN_VALUES=
HONO_OUT_VALUES=
HONO_POLL_SECONDS=60
HONO_LOOKBACK_HOURS=24
HONO_OVERLAP_MINUTES=60
